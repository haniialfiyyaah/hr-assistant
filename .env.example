OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
POLICY_INDEX_VERSION=policies-2026-01
# Local Compose: postgres service. Production (Render): Neon URL with sslmode=require.
DATABASE_URL=postgresql://hr_app:hr_app@localhost:5432/hr_assistant
# Local Compose only. On Render, omit REDIS_URL — cache degrades to miss (see docs/deploy.md).
REDIS_URL=redis://localhost:6379/0
# Streamlit → API. Local default in app.py is http://localhost:8000.
# On Render Blueprint, hr-assistant-ui sets API_URL from the API service URL.
API_URL=http://localhost:8000
# Host Compose ports; container addresses stay postgres:5432, redis:6379, and api:8000.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
STREAMLIT_PORT=8501
MODEL_MODE=live
MAX_AGENT_TURNS=4
MAX_TOOL_CALLS=6
MAX_OUTPUT_TOKENS=700
MODEL_TIMEOUT_SECONDS=30
PROPOSAL_TTL_MINUTES=15
RETRIEVAL_CACHE_TTL_SECONDS=900
# Configure rates only when supplied by the instructor/provider.
INPUT_COST_PER_1M=
OUTPUT_COST_PER_1M=
